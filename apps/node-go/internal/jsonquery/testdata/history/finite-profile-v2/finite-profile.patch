new file mode 100644
--- /dev/null
+++ b/v206/finite.go
@@ -0,0 +1,71 @@
+package jsonata
+
+import (
+	"errors"
+	"math"
+)
+
+const (
+	finiteResultMaxDepth  = 128
+	finiteResultMaxValues = 65536
+)
+
+var errFiniteResult = errors.New("JSON query result rejected by finite profile")
+
+// rejectNonfiniteResult implements the local finite-intermediate profile. Each
+// result has its own depth/value budget. Only JSON-shaped containers are walked;
+// functions, lexical environments and other opaque engine values are not inspected.
+// No reflection, pointer cache, host callbacks or user bindings are involved.
+// Cycles exhaust the depth budget (at most 129 edges); repeated references count
+// again. This bounds cyclic/shared graphs without skipping data after alias mutation.
+func rejectNonfiniteResult(value interface{}) error {
+	remaining := finiteResultMaxValues
+	return walkFiniteResult(value, 0, &remaining)
+}
+
+func walkFiniteResult(value interface{}, depth int, remaining *int) error {
+	if depth > finiteResultMaxDepth || *remaining == 0 {
+		return errFiniteResult
+	}
+	*remaining -= 1
+	switch v := value.(type) {
+	case float64:
+		if math.IsNaN(v) || math.IsInf(v, 0) {
+			return errFiniteResult
+		}
+	case float32:
+		if math.IsNaN(float64(v)) || math.IsInf(float64(v), 0) {
+			return errFiniteResult
+		}
+	case map[string]interface{}:
+		if len(v) > *remaining {
+			return errFiniteResult
+		}
+		for _, child := range v {
+			if err := walkFiniteResult(child, depth+1, remaining); err != nil {
+				return err
+			}
+		}
+	case []interface{}:
+		return walkFiniteItems(v, depth, remaining)
+	case *JSONataArray:
+		if v != nil {
+			return walkFiniteItems(v.Data, depth, remaining)
+		}
+	case JSONataArray:
+		return walkFiniteItems(v.Data, depth, remaining)
+	}
+	return nil
+}
+
+func walkFiniteItems(items []interface{}, depth int, remaining *int) error {
+	if len(items) > *remaining {
+		return errFiniteResult
+	}
+	for _, child := range items {
+		if err := walkFiniteResult(child, depth+1, remaining); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/v206/callbacks.go b/v206/callbacks.go
new file mode 100644
--- /dev/null
+++ b/v206/callbacks.go
@@ -0,0 +1,59 @@
+package jsonata
+
+// Matcher continuations use .apply in the pinned reference, rather than the
+// general expression invocation path. Raw native/partial objects lack that JS
+// method; normal DSL lambdas and expression argument wrappers have it. Track
+// only that distinction, without looking inside captured state or function code.
+func matcherContinuationCallable(value interface{}) bool {
+	switch fn := value.(type) {
+	case *Lambda:
+		return fn != nil && fn.matcherCallable
+	case *Function:
+		return fn != nil && fn.matcherCallable
+	case func() (interface{}, error):
+		return true // fixed native regex continuation
+	default:
+		return isFunction(value)
+	}
+}
+
+// comparatorTruthy follows the host JS conditional used by reference sort,
+// rather than JSONata's $boolean builtin: empty arrays/objects are truthy, null
+// is false. invokeFunction has already rejected nonfinite returned numbers.
+// Opaque values are never formatted, reflected, traversed or invoked here.
+func comparatorTruthy(value interface{}) bool {
+	switch v := value.(type) {
+	case nil, *JSONataNull, JSONataNull:
+		return false
+	case bool:
+		return v
+	case string:
+		return v != ""
+	case float64:
+		return v != 0
+	case float32:
+		return v != 0
+	case int:
+		return v != 0
+	case int8:
+		return v != 0
+	case int16:
+		return v != 0
+	case int32:
+		return v != 0
+	case int64:
+		return v != 0
+	case uint:
+		return v != 0
+	case uint8:
+		return v != 0
+	case uint16:
+		return v != 0
+	case uint32:
+		return v != 0
+	case uint64:
+		return v != 0
+	default:
+		return true
+	}
+}
