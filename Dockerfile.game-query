FROM node:24.22.3-alpine3.24 AS dependencies
WORKDIR /app/services/game-query
COPY services/game-query/package.json services/game-query/package-lock.json ./
RUN npm ci --omit=dev --omit=optional --ignore-scripts --no-audit --no-fund --no-bin-links
WORKDIR /app
COPY services/game-query/server.mjs services/game-query/worker.mjs services/game-query/server.test.mjs ./services/game-query/
COPY apps/node-go/internal/gamedigmonitor/catalogue.json apps/node-go/internal/gamedigmonitor/upstream.json ./apps/node-go/internal/gamedigmonitor/
RUN node --test --test-concurrency=1 services/game-query/server.test.mjs

# Keep package managers and their bundled dependencies out of the shipped image.
FROM alpine:3.24.4 AS runtime
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates libatomic libstdc++ \
    && addgroup -g 1000 node \
    && adduser -u 1000 -G node -s /bin/sh -D node
COPY --from=dependencies /usr/local/bin/node /usr/local/bin/node
COPY --from=dependencies /usr/local/bin/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY --from=dependencies /usr/local/LICENSE /usr/share/licenses/node/LICENSE
RUN node --version
WORKDIR /app
COPY --from=dependencies /app/services/game-query/node_modules ./services/game-query/node_modules
COPY services/game-query/package.json services/game-query/server.mjs services/game-query/worker.mjs ./services/game-query/
COPY apps/node-go/internal/gamedigmonitor/catalogue.json apps/node-go/internal/gamedigmonitor/upstream.json ./apps/node-go/internal/gamedigmonitor/
COPY apps/node-go/internal/gamedigmonitor/LICENSE.gamedig /usr/share/licenses/uptime-canary-game-query/LICENSE.gamedig
COPY LICENSE /usr/share/licenses/uptime-canary-game-query/LICENSE
COPY services/game-query/THIRD_PARTY_NOTICES.txt services/game-query/third-party-manifest.json /usr/share/licenses/uptime-canary-game-query/
ENV CANARY_GAME_QUERY_HOST=0.0.0.0 CANARY_GAME_QUERY_PORT=3121
USER node
ENTRYPOINT ["docker-entrypoint.sh"]
EXPOSE 3121
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD node -e "fetch('http://127.0.0.1:3121/readyz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "--max-old-space-size=64", "--permission", "--allow-worker", "--allow-fs-read=/app/services/game-query", "--allow-fs-read=/app/apps/node-go/internal/gamedigmonitor", "services/game-query/server.mjs"]
